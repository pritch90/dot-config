export JDTLS_JAVA_VERSION="25.0.3-amzn"
export NEOVIM_MIN_VERSION="0.12.0"
export NVM_VERSION="v0.40.3"

# Default Node version installed by nvm and set as the default alias. Any
# nvm-understood value works, e.g. "lts/*", "22", "v22.11.0". Override in
# local.env to pin a machine to something specific.
export NODE_VERSION="lts/*"

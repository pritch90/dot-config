# Core toolchain. Always installed.
#
# nvm is deliberately absent: the Homebrew formula installs to
# /opt/homebrew/opt/nvm and never creates $NVM_DIR (~/.nvm), which is where
# .config/zsh/tools.zsh looks for it. install.sh curl-installs nvm instead.

tap "jandedobbeleer/oh-my-posh"

# Version control
brew "git"
brew "gh"
brew "git-delta"
brew "git-lfs"
brew "git-gui"
brew "lazygit"

# Shell and terminal
brew "tmux"
brew "tmuxinator"
brew "oh-my-posh"
brew "zsh-completions"

# Editor and file navigation
brew "neovim"
brew "fd"
brew "ripgrep"
brew "fzf"
brew "yazi"
brew "tree"

# General CLI
brew "jq"
brew "wget"
brew "curl"
brew "gnu-sed"
brew "adr-tools"

# JVM
brew "gradle"
brew "groovy"
brew "maven"

# Node and Go
brew "node"
brew "pnpm"
brew "yarn"
brew "go"

# Containers
brew "docker-compose"
cask "docker-desktop"

cask "kdiff3"

# Core toolchain. Always installed, regardless of stack selection.
#
# Language-specific packages live in Brewfile.stack.<name> and are pulled in
# based on ~/.config/dotfiles/stacks.

tap "jandedobbeleer/oh-my-posh"

# Version control
brew "git"
brew "gh"
brew "git-delta"
brew "git-lfs"
brew "git-gui"
brew "lazygit"

# Shell and terminal
brew "tmux"
brew "tmuxinator"
brew "oh-my-posh"
brew "zsh-completions"

# Editor and file navigation
brew "neovim"
brew "fd"
brew "ripgrep"
brew "fzf"
brew "yazi"
brew "tree"

# General CLI
brew "jq"
brew "wget"
brew "curl"
brew "gnu-sed"
brew "adr-tools"

# Fonts
# Nerd Font is a hard dependency: nvim-web-devicons and blink.cmp's
# nerd_font_variant both expect one, and render tofu boxes without it.
cask "font-fira-code-nerd-font"

# Containers
brew "docker-compose"
cask "docker-desktop"

cask "kdiff3"
